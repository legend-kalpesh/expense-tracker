# Copy this file to ".env" and fill in YOUR values. Never commit .env to GitHub.
PORT=5000

# MySQL connection (use the user/password you created in MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=expense_tracker_db

# Long random text used to sign login tokens. Example generator (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
